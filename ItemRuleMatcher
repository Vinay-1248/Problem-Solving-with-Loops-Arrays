import java.util.Arrays;
import java.util.List;

public class ItemRuleMatcher {
    
    public int countMatches(List<List<String>> items, String ruleKey, String ruleValue) {
        // Step 1: Determine which index to check based on the ruleKey
        int checkIndex = 0; // Default to "type"
        
        if (ruleKey.equals("color")) {
            checkIndex = 1;
        } else if (ruleKey.equals("name")) {
            checkIndex = 2;
        }
        
        // Step 2 & 3: Iterate through the items and count the matches
        int matchCount = 0;
        for (List<String> item : items) {
            if (item.get(checkIndex).equals(ruleValue)) {
                matchCount++;
            }
        }
        
        return matchCount;
    }

    public static void main(String[] args) {
        ItemRuleMatcher matcher = new ItemRuleMatcher();
        
        // Test case 1
        List<List<String>> items1 = Arrays.asList(
            Arrays.asList("phone", "blue", "pixel"),
            Arrays.asList("computer", "silver", "lenovo"),
            Arrays.asList("phone", "gold", "iphone")
        );
        String ruleKey1 = "color";
        String ruleValue1 = "silver";
        
        System.out.println("Matches: " + matcher.countMatches(items1, ruleKey1, ruleValue1)); 
        // Output: 1 (Only the lenovo computer is silver)
        
        // Test case 2
        String ruleKey2 = "type";
        String ruleValue2 = "phone";
        System.out.println("Matches: " + matcher.countMatches(items1, ruleKey2, ruleValue2)); 
        // Output: 2 (The pixel and the iphone are both phones)
    }
}
