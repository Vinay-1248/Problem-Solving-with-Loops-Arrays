public class SalaryAnalyzer {
    
    public double average(int[] salary) {
        int minSalary = Integer.MAX_VALUE;
        int maxSalary = Integer.MIN_VALUE;
        
        // Use double for the sum to avoid integer overflow and 
        // to ensure the final division yields a decimal result
        double sum = 0; 
        
        for (int s : salary) {
            sum += s;
            
            if (s < minSalary) {
                minSalary = s;
            }
            if (s > maxSalary) {
                maxSalary = s;
            }
        }
        
        // Remove the min and max salaries from the total sum
        sum = sum - minSalary - maxSalary;
        
        // Divide by the number of elements minus 2
        return sum / (salary.length - 2);
    }

    public static void main(String[] args) {
        SalaryAnalyzer analyzer = new SalaryAnalyzer();
        
        int[] salary1 = {4000, 3000, 1000, 2000};
        System.out.println("Average: " + analyzer.average(salary1)); 
        // Output: 2500.0
        
        int[] salary2 = {1000, 2000, 3000};
        System.out.println("Average: " + analyzer.average(salary2)); 
        // Output: 2000.0
    }
}
